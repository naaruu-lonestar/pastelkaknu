# Contoh variabel lingkungan Pastel Ibu.
#
# Catatan penting: aplikasi TIDAK membaca file .env saat berjalan. Nilai runtime
# dibaca Worker dari blok "vars" di wrangler.jsonc (lokal maupun deploy).
# File ini hanya dokumentasi + dipakai skrip pembuatan admin lewat process.env.
#
# Salin menjadi .env bila ingin memakai nilai ini di shell:
#   cp .env.example .env

# ---------------------------------------------------------------- runtime
# Nama usaha yang tampil di situs publik dan pesan WhatsApp.
BUSINESS_NAME=Pastel Ibu

# Nomor WhatsApp admin, format internasional tanpa "+" dan tanpa spasi.
# GANTI sebelum dipakai produksi; ini masih placeholder.
WHATSAPP_NUMBER=6281234567890

# Masa berlaku sesi admin (jam). Dibulatkan ke 1..72.
ADMIN_SESSION_TTL_HOURS=8

# ------------------------------------------------------------ skrip admin
# Dipakai `npm run admin:create` / node scripts/create-admin.mjs.
# Password minimal 10 karakter. Jangan commit file .env berisi nilai asli.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin Pastel Ibu
ADMIN_ROLE=OWNER
D1_DATABASE_NAME=pastel-ibu-db
