# Contoh variabel lingkungan Pastel Ibu.
#
# Salin menjadi .env untuk pengembangan lokal:
#   cp .env.example .env
#
# Untuk produksi (Vercel), isi variabel yang sama di
# Project → Settings → Environment Variables. File .env TIDAK ikut ter-commit.

# ---------------------------------------------------------------- database
# URL database Turso. Untuk lokal boleh memakai file SQLite:
#   TURSO_DATABASE_URL=file:.local/pastel-ibu.db
TURSO_DATABASE_URL=

# Token database Turso. Kosongkan untuk database file lokal.
# Jangan pernah menulis token asli ke file yang di-commit.
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------- runtime
# Nama usaha yang tampil di situs publik dan pesan WhatsApp.
BUSINESS_NAME=Pastel Ibu

# Nomor WhatsApp admin, format internasional tanpa "+" dan tanpa spasi.
# GANTI sebelum dipakai produksi; ini masih placeholder.
WHATSAPP_NUMBER=6281234567890

# Masa berlaku sesi admin (jam). Dibulatkan ke 1..72.
ADMIN_SESSION_TTL_HOURS=8

# ------------------------------------------------------------ skrip admin
# Dipakai `npm run admin:create`. Password minimal 10 karakter.
# Kosongkan di file ini; isi lewat shell saat menjalankan skrip.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin Pastel Ibu
ADMIN_ROLE=OWNER

# Di Vercel, ADMIN_EMAIL + ADMIN_PASSWORD (min. 10 karakter) juga dipakai untuk
# membuat akun admin pertama secara otomatis saat tabel admin masih kosong.
# Setelah akun dibuat, hapus ADMIN_PASSWORD dari Environment Variables.
